# Local app database. docker compose maps Postgres 16 to host port 5434.
# Port 5432 is the usual local Postgres port, and this machine also binds 5433.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/music_for_the_ages
DATABASE_URL_READONLY=postgresql://chart_reader:chart_reader@localhost:5434/music_for_the_ages

# ollama (default) | openai | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_API_KEY=

OLLAMA_URL=http://127.0.0.1:11434

# Base URL of a local whisper.cpp server. Leave empty to disable the voice fallback.
# Example: http://127.0.0.1:8080
WHISPER_URL=
